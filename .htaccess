# WELL PHARMACY — portable rewrites (work at the domain root AND in a /wellpharmacy/ subfolder)
Options -Indexes
DirectoryIndex index.php

RewriteEngine On
# No "RewriteBase /": letting Apache auto-detect the base keeps clean URLs working
# whether the site is served from the domain root or from a subfolder like /wellpharmacy/.

# never expose includes / db scripts / config / dev mail dumps
# (storage/mail holds OTP codes + customer names, addresses and phones — must never be fetchable)
RewriteRule ^(inc|db|storage)(/|$) - [F,L]

# redirect *.php -> clean URL, but leave assets/ + actions/ PHP endpoints (data.php, POST handlers) executing directly
RewriteCond %{THE_REQUEST} !\s[^?\s]*/(assets|actions)/[^?\s]+\.php[\s?] [NC]
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# serve clean URL from the matching .php file (relative to this folder, so subfolders work)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^.]+?)/?$ $1.php [L]

# a missing IMAGE / asset gets a plain 404, not the full styled page (session + DB + chrome
# for every broken <img> was a whole page render per missing picture)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule \.(jpe?g|png|gif|webp|avif|svg|ico|css|js|woff2?|ttf|map)$ - [R=404,L,NC]

# anything else that isn't a real file/dir -> styled 404 (relative target keeps it subfolder-portable)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]

# working files that may sit next to the site (price lists, notes, archives, dumps) are never served
<FilesMatch "\.(md|csv|xlsx?|sql|zip|tar|gz|bak|log|json|ini|env)$">
  Require all denied
</FilesMatch>

# don't execute PHP inside uploads
<FilesMatch "\.(php|phtml|phar)$">
  <If "%{REQUEST_URI} =~ m#/uploads/#">
    Require all denied
  </If>
</FilesMatch>

# photo uploads: the host's PHP default is 2M a photo / 8M a save. The live server runs PHP
# through LiteSpeed LSAPI, which reads php_value here and ignores .user.ini. Kept OUTSIDE
# cPanel's "php ini directives" block so its MultiPHP INI Editor never rewrites it.
# (No effect on a local XAMPP copy: neither module exists there.)
<IfModule lsapi_module>
   php_value upload_max_filesize 20M
   php_value post_max_size 64M
   php_value max_file_uploads 50
   php_value memory_limit 256M
</IfModule>
<IfModule php8_module>
   php_value upload_max_filesize 20M
   php_value post_max_size 64M
   php_value max_file_uploads 50
   php_value memory_limit 256M
</IfModule>
